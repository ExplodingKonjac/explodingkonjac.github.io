{
  "name": "personal-pages",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm build && pnpm preview",
    "check": "pnpm format:check && pnpm -r --if-present check && pnpm test",
    "build": "pnpm -r --if-present build && pnpm assemble",
    "assemble": "node scripts/assemble.mjs",
    "preview": "node scripts/preview.mjs",
    "verify": "node scripts/verify-site.mjs",
    "test": "node --test scripts/*.test.mjs components/blog/src/plugins/*.test.mjs components/blog/src/config/*.test.mjs components/blog/src/lib/*.test.ts",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "cheerio": "1.2.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0"
  }
}
