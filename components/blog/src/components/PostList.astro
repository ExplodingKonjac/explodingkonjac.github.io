---
import type { CollectionEntry } from 'astro:content';
import { postUrl, tagUrl, formatDate } from '../lib/posts';
import GlassSurface from './GlassSurface.astro';
interface Props {
  posts: CollectionEntry<'posts'>[];
  searchable?: boolean;
}
const { posts, searchable = false } = Astro.props;
---

<ol class="post-list">
  {posts.map((post) => (
    <li
      class="post-card glass"
      data-post-key={post.id}
      data-post-url={postUrl(post)}
    >
      <GlassSurface />
      <span class="post-arrow" aria-hidden="true">
        ↗
      </span>
      <div class="post-date">
        <time datetime={post.data.pubDate.toISOString()} data-ui-date>
          {formatDate(post.data.pubDate)}
        </time>
        {post.data.draft && (
          <span class="draft-badge" data-i18n="post.draft">
            Draft
          </span>
        )}
      </div>
      <h2 data-post-title>
        <a class="post-link" href={postUrl(post)}>
          {post.data.title}
        </a>
      </h2>
      <p data-post-description>{post.data.description}</p>
      {searchable && <p class="search-excerpt" hidden />}
      <ul class="tags" aria-label="Post tags" data-i18n-aria="post.tags">
        {post.data.tags.map((tag) => (
          <li>
            <a href={tagUrl(tag)}>{tag}</a>
          </li>
        ))}
      </ul>
    </li>
  ))}
</ol>
{posts.length === 0 && (
  <div class="empty-state glass">
    <GlassSurface />
    <p data-i18n="post.empty">No published posts yet.</p>
  </div>
)}
