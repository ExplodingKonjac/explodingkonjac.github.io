---
import type { CollectionEntry } from 'astro:content';
import { postUrl, tagUrl, formatDate } from '../lib/posts';
import GlassSurface from './GlassSurface.astro';
interface Props {
  posts: CollectionEntry<'posts'>[];
}
const { posts } = Astro.props;
---

<ol class="post-list">
  {posts.map((post) => (
    <li
      class="post-card glass"
      data-post-key={post.id}
      data-post-url={postUrl(post)}
    >
      <GlassSurface />
      <div class="post-date">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        {post.data.draft && <span class="draft-badge">Draft</span>}
      </div>
      <h2>
        <a class="post-link" href={postUrl(post)}>
          {post.data.title}
          <span class="post-arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      </h2>
      <p>{post.data.description}</p>
      <ul class="tags" aria-label="Post tags">
        {post.data.tags.map((tag) => (
          <li>
            <a href={tagUrl(tag)}>{tag}</a>
          </li>
        ))}
      </ul>
    </li>
  ))}
</ol>
{posts.length === 0 && (
  <div class="empty-state glass">
    <GlassSurface />
    <p>No published notes yet.</p>
  </div>
)}
