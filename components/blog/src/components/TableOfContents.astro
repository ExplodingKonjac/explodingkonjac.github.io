---
import GlassSurface from './GlassSurface.astro';
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}
const { headings } = Astro.props;
---

<aside class="toc glass glass-clear">
  <GlassSurface />
  <nav class="toc-desktop" aria-label="On this page" data-i18n-aria="toc.title">
    <h2 data-i18n="toc.title">On this page</h2>
    <ol>
      {headings.map((heading) => (
        <li class:list={{ 'toc-nested': heading.depth === 3 }}>
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))}
    </ol>
  </nav>
  <details class="toc-mobile">
    <summary>
      <span data-i18n="toc.title">On this page</span>{' '}
      <span aria-hidden="true">+</span>
    </summary>
    <nav aria-label="On this page" data-i18n-aria="toc.title">
      <ol>
        {headings.map((heading) => (
          <li class:list={{ 'toc-nested': heading.depth === 3 }}>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  </details>
</aside>
