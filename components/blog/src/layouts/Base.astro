---
import { blogUrl, site, absoluteUrl } from '../config/site.ts';
import { ClientRouter } from 'astro:transitions';
import Background from '../components/Background.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Locale from '../components/Locale.astro';
import { languageStorageKey } from '../config/i18n';
import { themeStorageKey } from '../config/appearance';
import '../styles/global.css';
import 'katex/dist/katex.min.css';

interface Props {
  title?: string;
  description?: string;
  article?: boolean;
  pubDate?: Date;
  updatedDate?: Date;
  draft?: boolean;
  titleKey?: string;
  descriptionKey?: string;
  tag?: string;
}
const {
  title = 'Blog',
  description = site.description,
  article = false,
  pubDate,
  updatedDate,
  draft = false,
  titleKey,
  descriptionKey,
  tag,
} = Astro.props;
const pageTitle = `${title} · ${site.name}`;
const canonical = absoluteUrl(Astro.url.pathname);
const uiParams = JSON.stringify({ site: site.name, tag });
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content={description}
      data-i18n-content={descriptionKey}
      data-i18n-params={uiParams}
    />
    <meta name="theme-color" content="#e3eaf5" />
    <script is:inline define:vars={{ themeStorageKey, languageStorageKey }}>
      (() => {
        let preference;
        try {
          preference = localStorage.getItem(themeStorageKey);
        } catch {}
        const theme =
          preference === 'light' || preference === 'dark'
            ? preference
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]').content =
          theme === 'dark' ? '#141d30' : '#e3eaf5';
        let language;
        try {
          language = localStorage.getItem(languageStorageKey);
        } catch {}
        document.documentElement.lang =
          window.__blogLocale?.language ??
          (language === 'en' || language === 'zh-CN'
            ? language
            : /^zh(?:-|$)/i.test(navigator.language)
              ? 'zh-CN'
              : 'en');
        document.documentElement.dataset.localePending = '';
      })();
    </script>
    <ClientRouter fallback="swap" />
    <meta
      property="og:title"
      content={pageTitle}
      data-i18n-content={titleKey}
      data-i18n-params={uiParams}
    />
    <meta
      property="og:description"
      content={description}
      data-i18n-content={descriptionKey}
      data-i18n-params={uiParams}
    />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta name="twitter:card" content="summary" />
    {pubDate && (
      <meta property="article:published_time" content={pubDate.toISOString()} />
    )}
    {updatedDate && (
      <meta
        property="article:modified_time"
        content={updatedDate.toISOString()}
      />
    )}
    {draft && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name}'s blog`}
      href={blogUrl('rss.xml')}
    />
    <title data-i18n={titleKey} data-i18n-params={uiParams}>{pageTitle}</title>
  </head>
  <body>
    <Background />
    <svg
      id="glass-filters"
      class="glass-filter-defs"
      aria-hidden="true"
      transition:persist="glass-filters"
    >
      <defs />
    </svg>
    <div
      id="glass-flight-layer"
      aria-hidden="true"
      transition:persist="glass-flight-layer"
    ></div>
    <a href="#main" class="skip-link" data-i18n="skip">
      Skip to content
    </a>
    <div class="shell">
      <SiteHeader />
      <div class="page-stage">
        <main id="main" data-page={article ? 'post' : 'listing'} tabindex="-1">
          <slot />
        </main>
      </div>
    </div>
    <Locale />
    <script>
      import { prepareGlass } from '../lib/glass';
      import { initializeNavigation } from '../lib/navigation';
      prepareGlass();
      initializeNavigation();
    </script>
  </body>
</html>
