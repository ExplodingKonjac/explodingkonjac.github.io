---
import { blogUrl, site, absoluteUrl } from '../config/site.mjs';
import { ClientRouter } from 'astro:transitions';
import Background from '../components/Background.astro';
import GlassSurface from '../components/GlassSurface.astro';
import Locale from '../components/Locale.astro';
import { languageStorageKey } from '../config/i18n';
import { themeStorageKey } from '../config/appearance';
import '../styles/global.css';
import 'katex/dist/katex.min.css';

interface Props {
  title?: string;
  description?: string;
  article?: boolean;
  pubDate?: Date;
  updatedDate?: Date;
  draft?: boolean;
  titleKey?: string;
  descriptionKey?: string;
  tag?: string;
}
const {
  title = 'Blog',
  description = site.description,
  article = false,
  pubDate,
  updatedDate,
  draft = false,
  titleKey,
  descriptionKey,
  tag,
} = Astro.props;
const pageTitle = `${title} · ${site.name}`;
const canonical = absoluteUrl(Astro.url.pathname);
const tagsActive = Astro.url.pathname.startsWith(blogUrl('tags'));
const searchActive = Astro.url.pathname.startsWith(blogUrl('search'));
const uiParams = JSON.stringify({ site: site.name, tag });
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content={description}
      data-i18n-content={descriptionKey}
      data-i18n-params={uiParams}
    />
    <meta name="theme-color" content="#e3eaf5" />
    <script is:inline define:vars={{ themeStorageKey, languageStorageKey }}>
      (() => {
        let preference;
        try {
          preference = localStorage.getItem(themeStorageKey);
        } catch {}
        const theme =
          preference === 'light' || preference === 'dark'
            ? preference
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]').content =
          theme === 'dark' ? '#141d30' : '#e3eaf5';
        let language;
        try {
          language = localStorage.getItem(languageStorageKey);
        } catch {}
        document.documentElement.lang =
          window.__blogLocale?.language ??
          (language === 'en' || language === 'zh-CN'
            ? language
            : /^zh(?:-|$)/i.test(navigator.language)
              ? 'zh-CN'
              : 'en');
        document.documentElement.dataset.localePending = '';
      })();
    </script>
    <ClientRouter fallback="swap" />
    <meta
      property="og:title"
      content={pageTitle}
      data-i18n-content={titleKey}
      data-i18n-params={uiParams}
    />
    <meta
      property="og:description"
      content={description}
      data-i18n-content={descriptionKey}
      data-i18n-params={uiParams}
    />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta name="twitter:card" content="summary" />
    {pubDate && (
      <meta property="article:published_time" content={pubDate.toISOString()} />
    )}
    {updatedDate && (
      <meta
        property="article:modified_time"
        content={updatedDate.toISOString()}
      />
    )}
    {draft && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name}'s blog`}
      href={blogUrl('rss.xml')}
    />
    <title data-i18n={titleKey} data-i18n-params={uiParams}>{pageTitle}</title>
  </head>
  <body>
    <Background />
    <svg
      id="glass-filters"
      class="glass-filter-defs"
      aria-hidden="true"
      transition:persist="glass-filters"
    >
      <defs />
    </svg>
    <div
      id="glass-flight-layer"
      aria-hidden="true"
      transition:persist="glass-flight-layer"
    ></div>
    <a href="#main" class="skip-link" data-i18n="skip">
      Skip to content
    </a>
    <div class="shell">
      <div class="header-slot">
        <header
          class="site-header glass glass-clear"
          transition:name="blog-header"
          transition:persist="blog-header"
          transition:animate="none"
        >
          <GlassSurface />
          <div class="header-inner">
            <a href={blogUrl()} class="wordmark">
              {site.name}
              <span aria-hidden="true">.</span>
            </a>
            <div class="header-controls">
              <nav
                aria-label="Main navigation"
                data-i18n-aria="nav.main"
                data-pill-group
              >
                <a
                  href={blogUrl()}
                  data-nav="blog"
                  data-pill-item
                  aria-current={
                    !tagsActive && !searchActive ? 'page' : undefined
                  }
                  data-i18n="nav.blog"
                >
                  Blog
                </a>
                <a
                  href={blogUrl('tags')}
                  data-nav="tags"
                  data-pill-item
                  aria-current={tagsActive ? 'page' : undefined}
                  data-i18n="nav.tags"
                >
                  Tags
                </a>
                <a
                  href={blogUrl('search')}
                  data-nav="search"
                  data-pill-item
                  data-i18n="nav.search"
                  aria-current={searchActive ? 'page' : undefined}
                >
                  Search
                </a>
              </nav>
              <div class="header-tools">
                <a
                  class="icon-button github-link"
                  href={site.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="GitHub (opens in a new tab)"
                  data-i18n-aria="nav.github"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
                  </svg>
                </a>
                <button
                  class="icon-button theme-toggle"
                  type="button"
                  aria-label="Switch to dark mode"
                  hidden
                >
                  <svg
                    class="icon-sun"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="4" />
                    <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
                  </svg>
                  <svg
                    class="icon-moon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    aria-hidden="true"
                  >
                    <path d="M20.5 13.5A8.8 8.8 0 0 1 10.5 3.5 8.8 8.8 0 1 0 20.5 13.5Z" />
                  </svg>
                </button>
                <button
                  class="icon-button language-toggle"
                  type="button"
                  aria-label="Language: English. Switch to 简体中文"
                  hidden
                >
                  <span aria-hidden="true">EN</span>
                </button>
              </div>
            </div>
          </div>
        </header>
      </div>
      <div class="page-stage">
        <main id="main" data-page={article ? 'post' : 'listing'} tabindex="-1">
          <slot />
        </main>
      </div>
    </div>
    <Locale />
    <script>
      import '../scripts/appearance';
      import '../scripts/navbar';
      import '../scripts/selection-pill';
      import '../scripts/search';
      import '../scripts/navigation';
    </script>
  </body>
</html>
