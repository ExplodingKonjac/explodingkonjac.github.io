---
import { componentUrl, site, absoluteUrl } from '@site/config';
import '../styles/global.css';
import 'katex/dist/katex.min.css';

interface Props {
  title?: string;
  description?: string;
  article?: boolean;
  pubDate?: Date;
  updatedDate?: Date;
  draft?: boolean;
}
const {
  title = 'Blog',
  description = site.description,
  article = false,
  pubDate,
  updatedDate,
  draft = false,
} = Astro.props;
const pageTitle = `${title} · ${site.name}`;
const canonical = absoluteUrl(Astro.url.pathname);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f5f0" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta name="twitter:card" content="summary" />
    {pubDate && (
      <meta property="article:published_time" content={pubDate.toISOString()} />
    )}
    {updatedDate && (
      <meta
        property="article:modified_time"
        content={updatedDate.toISOString()}
      />
    )}
    {draft && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name}'s blog`}
      href={componentUrl('blog', 'rss.xml')}
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <div class="shell">
      <header class="site-header">
        <a href={componentUrl('blog')} class="wordmark">
          {site.name}
          <span aria-hidden="true">.</span>
        </a>
        <nav aria-label="Main navigation">
          <a href={componentUrl('blog')}>Blog</a>
          <a href={componentUrl('blog', 'tags')}>Tags</a>
          <a href={componentUrl('blog', 'rss.xml')}>RSS</a>
        </nav>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="site-footer">
        <span>Notes by {site.name}.</span>
      </footer>
    </div>
  </body>
</html>
