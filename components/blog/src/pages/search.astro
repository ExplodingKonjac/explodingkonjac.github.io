---
import Base from '../layouts/Base.astro';
import GlassSurface from '../components/GlassSurface.astro';
import PostList from '../components/PostList.astro';
import { publishedPosts } from '../lib/posts';
import { blogUrl } from '../config/site.ts';
const posts = (await publishedPosts()).filter((post) => !post.data.draft);
---

<Base
  title="Search"
  description="Find posts by title, summary, or content."
  titleKey="title.search"
  descriptionKey="search.description"
>
  <div data-search>
    <div class="page-heading glass">
      <GlassSurface />
      <h1 data-i18n="search.title">Search posts</h1>
      <p data-i18n="search.description">
        Find posts by title, summary, or content.
      </p>
      <form class="search-form" role="search" action={blogUrl('search')}>
        <label
          for="post-search"
          class="visually-hidden"
          data-i18n="search.label"
        >
          Search posts
        </label>
        <div class="search-field">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            aria-hidden="true"
          >
            <circle cx="10.5" cy="10.5" r="6.5" />
            <path d="m16 16 4.5 4.5" />
          </svg>
          <input
            id="post-search"
            name="q"
            type="search"
            autocomplete="off"
            placeholder="Enter words to search…"
            data-i18n-placeholder="search.placeholder"
          />
          <button
            class="icon-button search-clear"
            type="reset"
            aria-label="Clear search"
            data-i18n-aria="search.clear"
            hidden
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              aria-hidden="true"
            >
              <path d="m6 6 12 12M6 18 18 6" />
            </svg>
          </button>
        </div>
        <button class="search-submit" type="submit" data-i18n="nav.search">
          Search
        </button>
      </form>
      <p
        class="search-status"
        data-search-status
        role="status"
        aria-live="polite"
        data-i18n="search.idle"
      >
        Type a word or phrase to find a post.
      </p>
      <noscript>
        <p data-i18n="search.nojs">
          Enable JavaScript to search. You can browse all published posts below.
        </p>
      </noscript>
    </div>
    <div data-search-results hidden>
      <PostList posts={posts} searchable />
    </div>
  </div>
  <noscript>
    <style is:inline>
      [data-search-results][hidden] {
        display: block !important;
      }
      .search-form,
      .search-status {
        display: none !important;
      }
    </style>
  </noscript>
</Base>

<script>
  import { blogUrl } from '../config/site.ts';
  import {
    loadSearchIndex,
    setSearchStatus,
    renderSearch,
    prepareSearch,
  } from '../lib/search-ui';
  import { prepareGlass } from '../lib/glass';
  let controller: AbortController | undefined;
  let currentRoot: HTMLElement | null = null;
  function initialize() {
    const root = document.querySelector<HTMLElement>('[data-search]');
    if (root === currentRoot && controller && !controller.signal.aborted)
      return;
    controller?.abort();
    currentRoot = root;
    if (!root) return;
    const page = new AbortController();
    controller = page;
    const { signal } = page;
    prepareSearch(document, new URL(location.href));
    const input = root.querySelector<HTMLInputElement>('input[name="q"]')!;
    const form = root.querySelector('form')!;
    let timer: ReturnType<typeof setTimeout> | undefined;
    let composing = false;
    const update = async (save = true) => {
      clearTimeout(timer);
      const query = input.value;
      if (save) {
        const url = new URL(location.href);
        if (query) url.searchParams.set('q', query);
        else url.searchParams.delete('q');
        history.replaceState(history.state, '', url);
      }
      renderSearch(root, query);
      if (query.trim()) {
        try {
          await loadSearchIndex();
        } catch {
          if (!signal.aborted && input.value === query)
            setSearchStatus(root, 'search.error');
          return;
        }
      }
      if (signal.aborted || !root.isConnected || input.value !== query) return;
      renderSearch(root, query);
      prepareGlass(root);
    };
    input.addEventListener(
      'input',
      (event) => {
        if (composing || (event as InputEvent).isComposing) return;
        clearTimeout(timer);
        timer = setTimeout(() => void update(), 100);
      },
      { signal },
    );
    input.addEventListener(
      'compositionstart',
      () => {
        composing = true;
        clearTimeout(timer);
      },
      { signal },
    );
    input.addEventListener(
      'compositionend',
      () => {
        composing = false;
        void update();
      },
      { signal },
    );
    form.addEventListener(
      'submit',
      (event) => {
        event.preventDefault();
        if (!composing) void update();
      },
      { signal },
    );
    form.addEventListener(
      'reset',
      (event) => {
        event.preventDefault();
        input.value = '';
        void update();
        input.focus();
      },
      { signal },
    );
    window.addEventListener(
      'popstate',
      () => {
        if (location.pathname !== blogUrl('search')) return;
        prepareSearch(document, new URL(location.href));
        void update(false);
      },
      { signal },
    );
    signal.addEventListener('abort', () => clearTimeout(timer), { once: true });
    void update(false);
  }
  document.addEventListener('astro:page-load', initialize);
  initialize();
</script>
