---
import Base from '../layouts/Base.astro';
import GlassSurface from '../components/GlassSurface.astro';
import PostList from '../components/PostList.astro';
import { publishedPosts } from '../lib/posts';
import { blogUrl } from '../config/site.mjs';
const posts = (await publishedPosts()).filter((post) => !post.data.draft);
---

<Base
  title="Search"
  description="Search titles, summaries, and post contents."
  titleKey="title.search"
  descriptionKey="search.description"
>
  <div data-search>
    <div class="page-heading glass">
      <GlassSurface />
      <p class="eyebrow" data-i18n="search.eyebrow">
        FIND A NOTE
      </p>
      <h1>
        <span data-i18n="search.title">Search the notebook</span>
        <span>.</span>
      </h1>
      <p data-i18n="search.description">
        Search titles, summaries, and post contents.
      </p>
      <form class="search-form" role="search" action={blogUrl('search')}>
        <label
          for="post-search"
          class="visually-hidden"
          data-i18n="search.label"
        >
          Search posts
        </label>
        <div class="search-field">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            aria-hidden="true"
          >
            <circle cx="10.5" cy="10.5" r="6.5" />
            <path d="m16 16 4.5 4.5" />
          </svg>
          <input
            id="post-search"
            name="q"
            type="search"
            autocomplete="off"
            placeholder="Enter words to search…"
            data-i18n-placeholder="search.placeholder"
          />
          <button
            class="icon-button search-clear"
            type="reset"
            aria-label="Clear search"
            data-i18n-aria="search.clear"
            hidden
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              aria-hidden="true"
            >
              <path d="m6 6 12 12M6 18 18 6" />
            </svg>
          </button>
        </div>
        <button class="search-submit" type="submit" data-i18n="nav.search">
          Search
        </button>
      </form>
      <p
        class="search-status"
        data-search-status
        role="status"
        aria-live="polite"
        data-i18n="search.idle"
      >
        Type a word or phrase to find a post.
      </p>
      <noscript>
        <p data-i18n="search.nojs">
          Enable JavaScript to search. You can browse all published posts below.
        </p>
      </noscript>
    </div>
    <div data-search-results hidden>
      <PostList posts={posts} searchable />
    </div>
  </div>
  <noscript>
    <style is:inline>
      [data-search-results][hidden] {
        display: block !important;
      }
      .search-form,
      .search-status {
        display: none !important;
      }
    </style>
  </noscript>
</Base>
