---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import GlassSurface from '../components/GlassSurface.astro';
import { publishedPosts } from '../lib/posts';
const posts = await publishedPosts();
---

<Base
  title="Blog"
  description="Notes on mathematics, algorithms, and technology."
  titleKey="title.blog"
  descriptionKey="meta.blog"
>
  <div class="page-heading glass">
    <GlassSurface />
    <p class="eyebrow" data-i18n="home.eyebrow">
      THE NOTEBOOK
    </p>
    <h1>
      <span data-i18n="home.title">Thinking in writing</span>
      <span>.</span>
    </h1>
    <p data-i18n="home.description">
      Mathematics, algorithms, and technology. Ideas worth working through.
    </p>
  </div>
  <PostList posts={posts} />
</Base>
