---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import GlassSurface from '../components/GlassSurface.astro';
import { publishedPosts } from '../lib/posts';
const posts = await publishedPosts();
---

<Base
  title="Blog"
  description="Browse all published posts, newest first."
  titleKey="title.blog"
  descriptionKey="meta.blog"
>
  <div class="page-heading glass">
    <GlassSurface />
    <h1 data-i18n="home.title">Blog posts</h1>
    <p data-i18n="home.description">
      Browse all published posts, newest first.
    </p>
  </div>
  <PostList posts={posts} />
</Base>
