---
import Base from '../../layouts/Base.astro';
import { publishedPosts, tagUrl } from '../../lib/posts';
const posts = await publishedPosts();
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<Base title="Tags" description="Browse the notebook by topic.">
  <div class="page-heading">
    <p class="eyebrow">BY TOPIC</p>
    <h1>
      Threads to follow<span>.</span>
    </h1>
    <p>Browse the notebook by subject.</p>
  </div>
  <ul class="tag-index">
    {tags.map((tag) => (
      <li>
        <a href={tagUrl(tag)}>
          {tag}
          <span>
            {posts.filter((post) => post.data.tags.includes(tag)).length}
          </span>
        </a>
      </li>
    ))}
  </ul>
</Base>
