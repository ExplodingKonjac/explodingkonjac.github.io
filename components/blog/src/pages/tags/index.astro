---
import Base from '../../layouts/Base.astro';
import GlassSurface from '../../components/GlassSurface.astro';
import { publishedPosts, tagUrl } from '../../lib/posts';
const posts = await publishedPosts();
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<Base
  title="Tags"
  description="Browse the notebook by topic."
  titleKey="title.tags"
  descriptionKey="meta.tags"
>
  <div class="page-heading glass">
    <GlassSurface />
    <p class="eyebrow" data-i18n="tags.eyebrow">
      BY TOPIC
    </p>
    <h1>
      <span data-i18n="tags.title">Threads to follow</span>
      <span>.</span>
    </h1>
    <p data-i18n="tags.description">Browse the notebook by subject.</p>
  </div>
  <ul class="tag-index">
    {tags.map((tag) => (
      <li>
        <a class="glass" href={tagUrl(tag)} data-tag-key={tag}>
          <GlassSurface />
          <span data-tag-label>{tag}</span>
          <span class="tag-count">
            {posts.filter((post) => post.data.tags.includes(tag)).length}
          </span>
        </a>
      </li>
    ))}
  </ul>
</Base>
